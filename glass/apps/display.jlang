// display.jlang - shared dual-display graphics driver for Glass apps.
// Drives the 32x8 MAX7219 LED matrix (bit-banged SPI on GPIO 18/19/2) and
// the 128x64 SH1106/SSD1306 OLED framebuffer over I2C (address 0x3C).

const BUTTON = 1
const LED_DIN = 18
const LED_CS = 2
const LED_CLK = 19
const OLED = 0x3C
const SH1106 = 1

let leds = alloc(32)
let led_sent = alloc(32)
let led_fresh = true

let fb = alloc(1024)
let oled_cmd = alloc(3)
let digits_buf = alloc(12)

let FONT = "\x00\x00\x00\x00\x00\x00\x00\x2F\x00\x00\x00\x07\x00\x07\x00\x14\x3E\x14\x3E\x14\x04\x2A\x3E\x2A\x10\x13\x08\x04\x32\x00\x14\x2A\x14\x20\x00\x00\x00\x07\x00\x00\x00\x1E\x21\x00\x00\x00\x21\x1E\x00\x00\x00\x2A\x1C\x2A\x00\x08\x08\x3E\x08\x08\x00\x40\x30\x10\x00\x08\x08\x08\x08\x00\x00\x30\x30\x00\x00\x10\x08\x04\x02\x00\x00\x1E\x21\x1E\x00\x00\x22\x3F\x20\x00\x22\x31\x29\x26\x00\x11\x25\x25\x1B\x00\x0C\x0A\x3F\x08\x00\x17\x25\x25\x19\x00\x1E\x25\x25\x18\x00\x01\x31\x0D\x03\x00\x1A\x25\x25\x1A\x00\x06\x29\x29\x1E\x00\x00\x36\x36\x00\x00\x40\x36\x16\x00\x00\x00\x08\x14\x22\x00\x14\x14\x14\x14\x00\x00\x22\x14\x08\x00\x00\x02\x29\x06\x00\x1E\x21\x2D\x0E\x00\x3E\x09\x09\x3E\x00\x3F\x25\x25\x1A\x00\x1E\x21\x21\x12\x00\x3F\x21\x21\x1E\x00\x3F\x25\x25\x21\x00\x3F\x05\x05\x01\x00\x1E\x21\x29\x3A\x00\x3F\x04\x04\x3F\x00\x00\x21\x3F\x21\x00\x10\x20\x20\x1F\x00\x3F\x0C\x12\x21\x00\x3F\x20\x20\x20\x00\x3F\x06\x06\x3F\x00\x3F\x06\x18\x3F\x00\x1E\x21\x21\x1E\x00\x3F\x09\x09\x06\x00\x1E\x31\x21\x5E\x00\x3F\x09\x19\x26\x00\x12\x25\x29\x12\x00\x00\x01\x3F\x01\x00\x1F\x20\x20\x1F\x00\x0F\x30\x30\x0F\x00\x3F\x18\x18\x3F\x00\x33\x0C\x0C\x33\x00\x00\x07\x38\x07\x00\x31\x29\x25\x23\x00\x00\x3F\x21\x21\x00\x02\x04\x08\x10\x00\x00\x21\x21\x3F\x00\x00\x02\x01\x02\x00\x20\x20\x20\x20\x00\x00\x01\x02\x00\x00\x18\x24\x14\x3C\x00\x3F\x24\x24\x18\x00\x18\x24\x24\x00\x00\x18\x24\x24\x3F\x00\x18\x34\x2C\x08\x00\x08\x3E\x09\x02\x00\x28\x54\x54\x4C\x00\x3F\x04\x04\x38\x00\x00\x24\x3D\x20\x00\x00\x20\x40\x3D\x00\x3F\x08\x14\x20\x00\x00\x21\x3F\x20\x00\x3C\x08\x0C\x38\x00\x3C\x04\x04\x38\x00\x18\x24\x24\x18\x00\x7C\x24\x24\x18\x00\x18\x24\x24\x7C\x00\x3C\x04\x04\x08\x00\x28\x2C\x34\x14\x00\x04\x1F\x24\x20\x00\x1C\x20\x20\x3C\x00\x00\x1C\x20\x1C\x00\x3C\x30\x30\x3C\x00\x24\x18\x18\x24\x00\x0C\x50\x20\x1C\x00\x24\x34\x2C\x24\x00\x00\x04\x1E\x21\x00\x00\x00\x3F\x00\x00\x00\x21\x1E\x04\x00\x02\x01\x02\x01\x00"
let HEX_DIGITS = "0123456789ABCDEF"

// ---- 32x8 MAX7219 LED matrix --------------------------------------------
fn led_send(word) {
    for i in 0..16 {
        pin_write(LED_DIN, word[15 - i])
        pin_write(LED_CLK, 1)
        pin_write(LED_CLK, 0)
    }
}

fn led_word(reg, data) {
    let w = 0
    w[11..8] = reg
    w[7..0] = data
    return w
}

fn led_all(reg, data) {
    pin_write(LED_CS, 0)
    for m in 0..4 {
        led_send(led_word(reg, data))
    }
    pin_write(LED_CS, 1)
}

fn led_clear_all() {
    for i in 0..32 {
        leds[i] = 0
    }
}

fn led_pixel(x, y, lit) {
    if x < 0 || x >= 32 || y < 0 || y >= 8 {
        return nil
    }
    let idx = (x / 8) * 8 + y
    let row = leds[idx]
    row[7 - x % 8] = lit
    leds[idx] = row
}

fn led_bar(x, h) {
    if x < 0 || x >= 32 {
        return nil
    }
    let ch = clamp(h, 0, 8)
    for y in 0..ch {
        led_pixel(x, 7 - y, 1)
    }
}

fn led_row32(y, v) {
    if y < 0 || y >= 8 {
        return nil
    }
    for m in 0..4 {
        let hi = 31 - m * 8
        leds[m * 8 + y] = v[hi..hi - 7]
    }
}

fn led_char_at(px, c) {
    if c < 32 || c > 126 {
        c = '?'
    }
    let f = (c - 32) * 5
    for cx in 0..5 {
        let x = px + cx
        if x >= 0 && x < 32 {
            let col = FONT[f + cx]
            for y in 0..8 {
                if col[y] == 1 {
                    led_pixel(x, y, 1)
                }
            }
        }
    }
}

fn led_str_at(px, s) {
    for i in 0..len(s) {
        led_char_at(px + i * 6, s[i])
    }
}

fn led_show() {
    for r in 0..8 {
        let changed = led_fresh
        for m in 0..4 {
            if leds[m * 8 + r] != led_sent[r * 4 + m] {
                changed = true
            }
        }
        if changed {
            pin_write(LED_CS, 0)
            for m in 0..4 {
                let b = leds[m * 8 + r]
                led_send(led_word(r + 1, b))
                led_sent[r * 4 + m] = b
            }
            pin_write(LED_CS, 1)
        }
    }
    led_fresh = false
}

// ---- 128x64 SH1106 / SSD1306 OLED framebuffer ---------------------------
fn oled_cmds(list) {
    i2c_write(OLED, 0x00, list, 0, len(list))
}

fn fb_clear() {
    for i in 0..1024 {
        fb[i] = 0
    }
}

fn fb_pixel(x, y, lit) {
    if x < 0 || x >= 128 || y < 0 || y >= 64 {
        return nil
    }
    let idx = (y / 8) * 128 + x
    let b = fb[idx]
    b[y % 8] = lit
    fb[idx] = b
}

fn fb_hline(x0, x1, y) {
    if y < 0 || y >= 64 {
        return nil
    }
    let a = clamp(min(x0, x1), 0, 127)
    let b = clamp(max(x0, x1), 0, 127)
    let base = (y / 8) * 128
    let bit = 1 << (y % 8)
    for x in a..b + 1 {
        fb[base + x] = fb[base + x] | bit
    }
}

fn fb_vline(x, y0, y1) {
    if x < 0 || x >= 128 {
        return nil
    }
    let a = clamp(min(y0, y1), 0, 63)
    let b = clamp(max(y0, y1), 0, 63)
    for y in a..b + 1 {
        let idx = (y / 8) * 128 + x
        fb[idx] = fb[idx] | (1 << (y % 8))
    }
}

fn fb_rect(x, y, w, h, fill) {
    if w <= 0 || h <= 0 {
        return nil
    }
    if fill {
        for yy in y..y + h {
            fb_hline(x, x + w - 1, yy)
        }
    } else {
        fb_hline(x, x + w - 1, y)
        fb_hline(x, x + w - 1, y + h - 1)
        fb_vline(x, y, y + h - 1)
        fb_vline(x + w - 1, y, y + h - 1)
    }
}

fn fb_char(x, y, c) {
    if c < 32 || c > 126 {
        c = '?'
    }
    let f = (c - 32) * 5
    if y >= 0 && y <= 56 && y % 8 == 0 {
        let base = (y / 8) * 128 + x
        for cx in 0..5 {
            if x + cx >= 0 && x + cx < 128 {
                fb[base + cx] = FONT[f + cx]
            }
        }
        return nil
    }
    for cx in 0..5 {
        let col = FONT[f + cx]
        for cy in 0..8 {
            if col[cy] == 1 {
                fb_pixel(x + cx, y + cy, 1)
            }
        }
    }
}

fn fb_str(x, y, s) {
    for i in 0..len(s) {
        fb_char(x + i * 6, y, s[i])
    }
    return x + len(s) * 6
}

fn fb_int(x, y, v) {
    let n = 0
    let neg = v < 0
    if !neg {
        v = -v
    }
    while true {
        digits_buf[n] = '0' - v % 10
        v = v / 10
        n += 1
        if v == 0 {
            break
        }
    }
    if neg {
        digits_buf[n] = '-'
        n += 1
    }
    for i in 0..n {
        fb_char(x + i * 6, y, digits_buf[n - 1 - i])
    }
    return x + n * 6
}

fn fb_hex(x, y, v) {
    x = fb_str(x, y, "0x")
    for i in 0..8 {
        let hi = 31 - i * 4
        fb_char(x + i * 6, y, HEX_DIGITS[v[hi..hi - 3]])
    }
    return x + 48
}

fn fb_show() {
    let x0 = SH1106 * 2
    for p in 0..8 {
        oled_cmd[0] = 0xB0 | p
        oled_cmd[1] = x0[3..0]
        oled_cmd[2] = 0x10 | x0[7..4]
        i2c_write(OLED, 0x00, oled_cmd, 0, 3)
        i2c_write(OLED, 0x40, fb, p * 128, 128)
    }
}

fn glass_init() {
    pin_mode(BUTTON, "in_pullup")
    pin_mode(LED_DIN, "out")
    pin_mode(LED_CS, "out")
    pin_mode(LED_CLK, "out")
    pin_write(LED_CS, 1)
    pin_write(LED_CLK, 0)
    led_all(0x0F, 0)
    led_all(0x09, 0)
    led_all(0x0B, 7)
    led_all(0x0A, 2)
    led_all(0x0C, 1)

    oled_cmds("\xAE\xD5\x80\xA8\x3F\xD3\x00\x40\xA1\xC8\xDA\x12\x81\xCF\xDB\x40\xA4\xA6")
    if SH1106 != 0 {
        oled_cmds("\xAD\x8B\xD9\x22")
    } else {
        oled_cmds("\x8D\x14\xD9\xF1")
    }
    oled_cmds("\xAF")
    led_clear_all()
    fb_clear()
    led_show()
    fb_show()
}
