print(1 + 2 * 3, (1 + 2) * 3, 10 - 4 - 3)  // expect: 7 9 3
print(7 / 2, -7 / 2, 7 % 3, -7 % 3)        // expect: 3 -3 1 -1
print(2147483647 + 1, -2147483648 - 1)     // expect: -2147483648 2147483647
print(65536 * 65536, 0xFFFFFFFF)           // expect: 0 -1
print(-(-2147483648), -2147483648 / -1)    // expect: -2147483648 -2147483648
print(1_000_000, 0x1F, 0b1010)             // expect: 1000000 31 10
print('A', 'z' - 'a', '\n', '\x41')        // expect: 65 25 10 65
print(3 < 4, 3 <= 3, 3 > 4, 3 >= 4)        // expect: true true false false
print(1 == 1, 1 != 1, "a" == "a", nil == false)  // expect: true false true false
let x = 10
x += 5
x -= 3
x *= 2
x /= 4
x %= 4
print(x)                                   // expect: 2
