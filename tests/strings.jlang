let s = "héllo"
print(s, len(s), s[0])                     // expect: héllo 6 104
print("tab\there", "q\"uote")              // expect: tab	here q"uote
printf("{} {d4}|{x} {x4} {b} {b8} {c}\n", "x", 42, 255, 255, 5, 5, 'J')
// expect: x   42|0xFF 0x00FF 0b101 0b00000101 J
printf("braces {{}} ok\n")                 // expect: braces {} ok
printf("no newline")
printf("\n")                               // expect: no newline
