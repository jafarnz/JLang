// Declarative wire-format bit-packing: arbitrary bit widths, signed/unsigned, be/le, pad.
let pkt = alloc(16)
defer free(pkt)

// 4-bit version (3), 1-bit flag (1), 3-bit mode (5), big-endian u16 (0x1234),
// little-endian signed i16 (-300), 4-bit pad + signed i4 (-5), 24-bit be (0xABCDEF).
let n = pack(pkt, 0, "u4 u1 u3 u16be i16le pad4 i4 u24be", 3, 1, 5, 0x1234, -300, -5, 0xABCDEF)
assert(n == 9)
printf("{x2} {x2} {x2} {x2} {x2} {x2}\n", pkt[0], pkt[1], pkt[2], pkt[3], pkt[4], pkt[5])

let fields = unpack(pkt, 0, "u4 u1 u3 u16be i16le pad4 i4 u24be")
defer free(fields)
assert(len(fields) == 7)
printf("{} {} {} {x4} {} {} {x6}\n", fields[0], fields[1], fields[2], fields[3], fields[4], fields[5], fields[6])
// expect: 0x3D 0x12 0x34 0xD4 0xFE 0x0B
// expect: 3 1 5 0x1234 -300 -5 0xABCDEF
