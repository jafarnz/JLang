// Arrays: literals, nesting, assignment, len, array(), printing.
let colors = [0xFF0000, 0x00FF00, rgb(0, 0, 255)]
print(len(colors), colors[2])
colors[0] += 1
colors[1] = "green"
print(colors)
let grid = [
    [0, 1, 0],
    [1, 1, 1],
]
grid[1][0] = 5
print(grid, len(grid[0]))
print([], array(3), array(2, true))
let words = ["a", "b"]
print(words)
let t = [1]
print(t == t, [2] == [2])
free(t)
// expect: 3 255
