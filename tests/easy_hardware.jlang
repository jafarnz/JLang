// The beginner built-ins on the simulated board.
// args: --pin 4=0 --analog 1=3000 --distance 42
turn_on(2)
toggle(2)
toggle(2)
turn_off(2)
brightness(3, 40)
color(8, "Orange")
color(8, rgb(1, 2, 3))
color_at(8, 2, 0x00FF00)
tone(7, "A4", 100)
tone(7, "C#5", 50)
tone(7, 440, 10)
tone(7, "rest", 40)
beep(7)
servo(9, 180)
print(pressed(4), pressed(4))
print(analog(1), analog(5))
print(distance(5, 6))
print(map(3000, 0, 4095, 0, 100), clamp(-5, 0, 10), clamp(50, 0, 10))
let r = random(1, 6)
assert(r >= 1 && r <= 6, "random() stays in range")
print(random(5, 5))
// expect: [sim      0ms] pin 2 -> HIGH
