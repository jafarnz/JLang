{
  "name": "jlang",
  "displayName": "JLang",
  "description": "Syntax highlighting for JLang, a small language for learning how hardware works.",
  "version": "0.1.0",
  "publisher": "jafarnz",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/jafarnz/JLang" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "jlang",
        "aliases": ["JLang", "jlang"],
        "extensions": [".jlang"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "jlang", "scopeName": "source.jlang", "path": "./syntaxes/jlang.tmLanguage.json" }
    ]
  }
}
