{
  "name": "jlang",
  "displayName": "JLang",
  "description": "Syntax highlighting, live diagnostics, hover docs, completion, and formatting for JLang.",
  "version": "0.2.0",
  "publisher": "jafarnz",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/jafarnz/JLang" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Formatters", "Linters"],
  "activationEvents": ["onLanguage:jlang"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jlang",
        "aliases": ["JLang", "jlang"],
        "extensions": [".jlang"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "jlang", "scopeName": "source.jlang", "path": "./syntaxes/jlang.tmLanguage.json" }
    ],
    "configuration": {
      "title": "JLang",
      "properties": {
        "jlang.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the jlang executable (defaults to jlang on PATH)."
        }
      }
    }
  }
}
