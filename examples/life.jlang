// life.jlang - Conway's Game of Life on the LED panel.
//
// Each pixel is a cell. A live cell with two or three live neighbours
// survives, and an empty cell with exactly three comes alive. The edges
// wrap around, so a glider that leaves on the right comes back on the left.

let W = led_width()
let H = led_height()

fn grid() {
    let g = array(H)
    for y in 0..H {
        g[y] = array(W)
    }
    return g
}

fn free_grid(g) {
    for y in 0..H {
        free(g[y])
    }
    free(g)
}

fn neighbours(g, x, y) {
    let n = 0
    for dy in -1..2 {
        for dx in -1..2 {
            if dx != 0 || dy != 0 {
                n += g[(y + dy + H) % H][(x + dx + W) % W]
            }
        }
    }
    return n
}

// Start with a few gliders and some random cells.
let cells = grid()
for i in 0..90 {
    cells[random(0, H - 1)][random(0, W - 1)] = 1
}

for gen in 0..80 {
    led_clear()
    for y in 0..H {
        for x in 0..W {
            if cells[y][x] == 1 {
                led(x, y, "green")
            }
        }
    }
    led_show()
    delay(80)

    let next = grid()
    for y in 0..H {
        for x in 0..W {
            let n = neighbours(cells, x, y)
            if n == 3 || (n == 2 && cells[y][x] == 1) {
                next[y][x] = 1
            }
        }
    }
    free_grid(cells)
    cells = next
}
free_grid(cells)
