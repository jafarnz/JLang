// graph.jlang - a live graph of a knob, on the panel and in the plotter.
//
// Each reading is printed as "knob: value", which the playground's Plot
// view draws as a line, and the panel scrolls a bar graph of the last 60.
// In the playground, turn the knob on the board picture.

let KNOB = 1
let W = led_width()
let H = led_height()
let history = array(W)

for t in 0..120 {
    // The knob, plus a little noise, like a real sensor.
    let value = clamp(analog(KNOB) + random(-200, 200), 0, 4095)
    print("knob:", value)

    // Move every reading one place left and add the new one on the right.
    for i in 0..W - 1 {
        history[i] = history[i + 1]
    }
    history[W - 1] = value

    led_clear()
    for x in 0..W {
        let h = map(history[x], 0, 4095, 0, H)
        for y in 0..h {
            let colour = "green"
            if y >= H - 2 {
                colour = "red"
            } else if y >= H - 4 {
                colour = "yellow"
            }
            led(x, H - 1 - y, colour)
        }
    }
    led_show()
    delay(50)
}
free(history)
